# Read-only native API checks. Never starts/stops/installs a service.
if(NOT EXISTS "${CONFIG_EXE}")
    message(FATAL_ERROR "CONFIG_EXE missing")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef instance)
set(instance "test-${instance}")
execute_process(COMMAND "${CONFIG_EXE}" service-control --action status --instance "${instance}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR NOT error MATCHES "Win32=1060" OR NOT error MATCHES "service is not installed")
    message(FATAL_ERROR "Missing-service diagnostic lost: ${result} ${output} ${error}")
endif()
foreach(arguments IN ITEMS "--action;invalid" "--action;status;--instance;bad.id" "--action;status;--timeout-seconds;0")
    execute_process(COMMAND "${CONFIG_EXE}" service-control ${arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR error MATCHES "Win32=")
        message(FATAL_ERROR "Invalid arguments reached SCM: ${result} ${error}")
    endif()
endforeach()
file(WRITE "${TEST_ROOT}/cancel.txt" "1\n0\n")
foreach(purpose IN ITEMS stop start restart)
    execute_process(COMMAND "${CONFIG_EXE}" choose-installed-instance --purpose "${purpose}"
        --output "${TEST_ROOT}/selected.txt" INPUT_FILE "${TEST_ROOT}/cancel.txt"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 2 AND NOT result EQUAL 3)
        message(FATAL_ERROR "${purpose} picker could not cancel or report empty list: ${result} ${error}")
    endif()
    file(READ "${TEST_ROOT}/selected.txt" selected)
    if(selected MATCHES "instance=")
        message(FATAL_ERROR "Cancelled picker returned a target")
    endif()
    if(output MATCHES "полного удаления|remove completely")
        message(FATAL_ERROR "${purpose} picker has uninstall text")
    endif()
endforeach()
execute_process(COMMAND "${CONFIG_EXE}" validate-script-messages RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Script message catalog invalid")
endif()
message(STATUS "Native service-control read-only checks passed")
